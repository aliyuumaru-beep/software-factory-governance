#!/usr/bin/env bash
# Software Factory governance git hook (SPEC-GOV-ENF-001 layer L3)
GOV="${GOV_HOME:-$HOME/.claude/governance}/govcore.py"
[ -f "$GOV" ] || { echo "governance gateway not installed — see AGENTS.md" >&2; exit 1; }
python3 "$GOV" githook pre-commit "$@" || exit 1
# chain to the repository's own hook if present
LOCAL="$(git rev-parse --git-common-dir)/hooks/pre-commit"
[ -x "$LOCAL" ] && exec "$LOCAL" "$@"
exit 0
